<Window x:Class="PhotoImporter.App.FilterSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="候補から条件を指定" Width="680" Height="620" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ComboBox x:Name="FieldBox" DisplayMemberPath="DisplayName" SelectionChanged="Field_Changed"
                  IsSynchronizedWithCurrentItem="False" MaxDropDownHeight="420"
                  AutomationProperties.Name="条件の項目">
            <ComboBox.GroupStyle>
                <StaticResource ResourceKey="FilterFieldGroupStyle" />
            </ComboBox.GroupStyle>
        </ComboBox>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10" TextWrapping="Wrap" />
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="候補を検索" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="候補を検索" />
        </DockPanel>
        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <CheckBox x:Name="ExactTimeBox" Content="時刻も選ぶ" Checked="Precision_Changed" Unchecked="Precision_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button x:Name="LatestButton" Content="最新の日" Click="Latest_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="PeriodButton" Content="全期間" Click="Period_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="LoadExifButton" Content="Exifを読み込んで候補を更新" Click="LoadExif_Click" Padding="10,4"/>
        </WrapPanel>
        <ListBox x:Name="ValuesList" Grid.Row="4" SelectionMode="Single"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Value_Changed"
                 AutomationProperties.Name="スキャン結果の候補">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0"
                                  Visibility="{Binding IsMultiple, Converter={StaticResource BoolVisibility}}"
                                  AutomationProperties.Name="{Binding Label}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ComboBox x:Name="BoundaryBox" Width="160" DisplayMemberPath="DisplayName" Margin="0,0,10,0"
                      AutomationProperties.Name="候補の使い方"/>
            <Button x:Name="UseButton" Content="条件に設定" Click="Use_Click" IsDefault="True" Padding="16,6" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="キャンセル" IsCancel="True" Padding="16,6"/>
        </WrapPanel>
    </Grid>
</Window>
