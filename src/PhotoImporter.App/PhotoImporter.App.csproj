<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PhotoImporter.App</RootNamespace>
    <AssemblyName>PhotoImporter</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Photo Importer</Product>
    <Company>KOBAT</Company>
    <Authors>KOBAT</Authors>
    <Copyright>Copyright © 2026 KOBAT</Copyright>
    <Description>Windows 11向けの写真取り込みアプリ</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PhotoImporter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoImporter.Core\PhotoImporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PhotoImporter.ico" />
  </ItemGroup>
</Project>
