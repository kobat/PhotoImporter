<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PhotoImporter.App</RootNamespace>
    <AssemblyName>PhotoImporter</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Photo Importer</Product>
    <Company>KOBAT</Company>
    <Authors>KOBAT</Authors>
    <Copyright>Copyright © 2026 KOBAT</Copyright>
    <Description>Windows 11向けの写真取り込みアプリ</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PhotoImporter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoImporter.Core\PhotoImporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PhotoImporter.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Legal\Licenses\*.txt" />
    <EmbeddedResource Include="Legal\Licenses\*.txt">
      <LogicalName>PhotoImporter.App.Legal.Licenses.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\LICENSE">
      <LogicalName>PhotoImporter.App.Legal.Licenses.PhotoImporterMIT.txt</LogicalName>
    </EmbeddedResource>
    <Content Include="Legal\Licenses\*.txt">
      <Link>Licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt">
      <Link>THIRD-PARTY-NOTICES.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
