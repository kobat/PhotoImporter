<Window x:Class="PhotoImporter.App.LicenseInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Importer ライセンス情報"
        Icon="Assets/PhotoImporter.ico"
        Width="900" Height="620"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ライセンス情報" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Photo Importer と、配布物に含まれる第三者ライブラリのライセンスを表示します。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="LicenseList"
                     DisplayMemberPath="DisplayName"
                     AutomationProperties.Name="ライセンスの対象">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,12,8,5"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="2,0,2,10"
                           Text="{Binding ElementName=LicenseList, Path=SelectedItem.Summary}"
                           TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox Grid.Row="1"
                         Text="{Binding ElementName=LicenseList, Path=SelectedItem.LicenseText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="ライセンス原文" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button HorizontalAlignment="Right" Content="閉じる" MinWidth="88"
                    IsDefault="True" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
