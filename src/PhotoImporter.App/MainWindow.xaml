<Window x:Class="PhotoImporter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Importer" Height="820" Width="1480"
        MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="CopyTargetCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="IsEnabled" Value="{Binding CanCopy}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="TokenDetailTemplate">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,0,0,1" Padding="0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TokenNameColumn" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Token}" FontFamily="Consolas" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                               Margin="12,0,8,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <ToggleButton Grid.Column="2" Width="24" Height="24" Padding="0"
                                  FontSize="10" IsChecked="{Binding IsFormatEditorVisible, Mode=TwoWay}"
                                  AutomationProperties.Name="トークン詳細の表示切り替え"
                                  ToolTip="トークンの説明と書式設定の表示を切り替えます">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="▼" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="▲" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormatEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="書式設定" Padding="4,2" Margin="0,0,0,7">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportsFormat}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding Description}" Foreground="DimGray"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FormatDescription}" Margin="0,7,0,0"
                                   Foreground="DimGray" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportsFormat}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="650" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="460" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding CanEditSettings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="コピー元" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" ToolTip="写真があるフォルダー" />
            <Button Grid.Column="2" Content="選択..." Click="SelectSource_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10" IsEnabled="{Binding CanEditSettings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="コピー先" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" ToolTip="取り込み先のフォルダー" />
            <Button Grid.Column="2" Content="選択..." Click="SelectDestination_Click" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="テンプレート" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditSettings}" Margin="0,0,8,0"
                     ToolTip="例: {ModifiedDate:yyyy-MM-dd}\{FileName}{Sequence}{Extension}" />
            <Button Grid.Column="2" Content="スキャン" MinWidth="100"
                    IsDefault="True" IsEnabled="{Binding CanScan}" Click="Scan_Click" />
        </Grid>

        <Grid Grid.Row="4" Margin="112,0,0,10" IsEnabled="{Binding CanEditSettings}">
            <StackPanel>
                <CheckBox Content="画像・動画以外のファイルも含める"
                          IsChecked="{Binding IncludeOtherFiles}"
                          ToolTip="有効にすると、既知のシステム管理項目を除くすべての通常ファイルをコピー対象としてスキャンします。" />
                <CheckBox Content="同名のXMPサイドカーを画像に関連付ける"
                          Margin="0,6,0,0"
                          IsChecked="{Binding AssociateSidecars}"
                          ToolTip="画像と同じフォルダー・同じ名前のXMPを、画像のコピー先名と連番へ追従させます。" />
                <CheckBox Content="RAW+JPEGペアではJPEGのみ解析する"
                          Margin="0,6,0,0"
                          IsChecked="{Binding AnalyzeJpegOnlyForRawJpegPair}" />
                <TextBlock Text="同じフォルダーにある同名のRAWとJPEGをペアとして扱います。ペアにならないRAWは個別に解析します"
                           Margin="20,2,0,0" Foreground="DimGray" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" Margin="0,0,0,10" Padding="8,5"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Exif設定" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ExifSettingsSummary}"
                           ToolTip="{Binding ExifSettingsToolTip}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ExifSettingsSummary" />
                <Button x:Name="ExifSettingsButton" Grid.Column="2" Content="設定..."
                        Margin="8,0,0,0" Padding="12,3"
                        IsEnabled="{Binding CanEditSettings}"
                        Click="ShowExifSettingsOverlay_Click"
                        AutomationProperties.AutomationId="OpenExifSettings"
                        AutomationProperties.Name="Exif設定を開く" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Grid.RowSpan="3" Grid.Column="0" Panel.ZIndex="20"
              Visibility="{Binding ExifSettingsOverlayVisibility}"
              Background="Transparent">
            <Border VerticalAlignment="Top" Padding="14"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Exif設定" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExifSettingsSummary}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" Foreground="DimGray" />
                        </StackPanel>
                        <Button x:Name="ExifOverlayCloseButton" Grid.Column="1"
                                Content="閉じる" Padding="12,3"
                                Click="CloseOverlay_Click"
                                AutomationProperties.AutomationId="CloseExifSettings"
                                AutomationProperties.Name="Exif設定を閉じる" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,0"
                                IsEnabled="{Binding CanEditSettings}">
                        <CheckBox Content="テンプレートで未使用の場合もExif情報を読み込む"
                                  IsChecked="{Binding ReadExifInformation}" Margin="0,0,0,8" />
                        <CheckBox Content="Exif キャッシュを利用する"
                                  IsChecked="{Binding UseExifCache}" />
                        <Grid Margin="20,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ExifCacheRoot, Mode=OneWay}" IsReadOnly="True"
                                     Margin="0,0,8,0"
                                     ToolTip="現在使用する Exif キャッシュの保存先" />
                            <Button Grid.Column="1" Content="保存先を変更..." Margin="0,0,8,0"
                                    Click="SelectExifCacheRoot_Click" />
                            <Button Grid.Column="2" Content="既定に戻す"
                                    Click="ResetExifCacheRoot_Click" />
                        </Grid>
                        <TextBlock Text="保存先を変えても、以前の保存先にあるキャッシュは移動・削除されません。"
                                   Margin="20,4,0,0" Foreground="DimGray" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="コピー設定" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="既存ファイルを上書きする"
                      IsEnabled="{Binding CanEditSettings}" IsChecked="{Binding OverwriteExisting}" />
            <Button Grid.Column="2" Content="{Binding CopyButtonText}" MinWidth="100" Margin="8,0,0,0"
                    IsEnabled="{Binding CanCopy}" Click="Copy_Click" />
            <Button Grid.Column="3" Content="キャンセル" MinWidth="100" Margin="8,0,0,0"
                    IsEnabled="{Binding CanCancel}" Click="Cancel_Click" />
        </Grid>

        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Margin="0,0,0,8" Padding="8,5"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FilterSummary}" ToolTip="{Binding FilterSummaryToolTip}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               AutomationProperties.AutomationId="FilterSummary" />
                    <TextBlock Grid.Column="1" Text="{Binding FilterEditStatus}"
                               Visibility="{Binding FilterEditStatusVisibility}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="FilterSettingsButton" Grid.Column="2" Content="編集..."
                            Margin="8,0,0,0" Padding="12,3"
                            IsEnabled="{Binding CanEditFilters}"
                            Click="ShowFilterOverlay_Click"
                            AutomationProperties.AutomationId="OpenFilterSettings"
                            AutomationProperties.Name="フィルター条件を編集" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ViewSelectionSummary}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          Content="絞り込みで非表示になった項目のチェックを外す"
                          IsChecked="{Binding UncheckHiddenItems, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelectItems}"
                          VerticalAlignment="Center" />
            </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedPreviewItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" EnableRowVirtualization="True"
                  IsEnabled="{Binding CanSelectItems}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource CopyTargetCheckBoxStyle}"
                                        EditingElementStyle="{StaticResource CopyTargetCheckBoxStyle}"
                                        Width="80">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsThreeState="True"
                                      IsChecked="{Binding DataContext.SelectAllState, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                      IsEnabled="{Binding DataContext.CanSelectAll, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                      Click="SelectAll_Click"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="コピー可能な項目をすべて選択または解除"
                                      ToolTip="コピー可能な項目をすべて選択／解除" />
                            <TextBlock Text="対象" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Header="コピー元" Binding="{Binding SourcePath}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="関連先" Binding="{Binding RelatedSourcePath}" Width="140" IsReadOnly="True" />
                <DataGridTextColumn Header="コピー先（予定）" Binding="{Binding DestinationPath}" Width="3*" IsReadOnly="True" />
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="180" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

            <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="11"
                  Visibility="{Binding FilterOverlayVisibility}">
                <Border Padding="14"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="フィルター条件" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FilterSummary}" Margin="0,3,0,0"
                                           ToolTip="{Binding FilterSummaryToolTip}"
                                           TextTrimming="CharacterEllipsis" Foreground="DimGray" />
                            </StackPanel>
                            <Button x:Name="FilterOverlayCloseButton" Grid.Column="1"
                                    Content="閉じる" Padding="12,3"
                                    Click="CloseOverlay_Click"
                                    AutomationProperties.AutomationId="CloseFilterSettings"
                                    AutomationProperties.Name="フィルター条件を閉じる" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding CanEditFilters}">
                            <StackPanel>
                                <TextBlock Text="すべての条件に一致する項目を表示します。"
                                           Foreground="DimGray" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding FilterConditions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                    BorderThickness="0,0,0,1" Padding="0,7,0,9">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="260" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding FieldOptions}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedItem="{Binding SelectedField, Mode=TwoWay}" />
                                                        <ComboBox Grid.Column="1" Margin="8,0"
                                                                  ItemsSource="{Binding TargetModes}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedItem="{Binding SelectedTargetMode, Mode=TwoWay}" />
                                                        <Button Grid.Column="2" Content="削除"
                                                                Click="RemoveFilterCondition_Click"
                                                                AutomationProperties.Name="このフィルター条件を削除" />
                                                    </Grid>

                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsString}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding StringMatchModes}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedItem="{Binding SelectedStringMatchMode, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Margin="8,0"
                                                                 Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="比較する文字列" />
                                                        <CheckBox Grid.Column="2" Content="大文字・小文字を区別"
                                                                  IsChecked="{Binding CaseSensitive}"
                                                                  IsEnabled="{Binding CanUseCaseSensitivity}"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>

                                                    <WrapPanel Margin="0,7,0,0">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <TextBlock Text="最小" VerticalAlignment="Center" />
                                                        <TextBox Width="150" Margin="6,0,12,0"
                                                                 Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="最大" VerticalAlignment="Center" />
                                                        <TextBox Width="150" Margin="6,0,12,0"
                                                                 Text="{Binding MaximumText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <CheckBox Content="連番なし" IsChecked="{Binding IncludeNoSequence}"
                                                                  Margin="0,0,12,0">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSequence}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <CheckBox Content="Rejected" IsChecked="{Binding IncludeRejectedRating}">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRating}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,7,0,0">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDateTime}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <TextBlock Text="開始日" VerticalAlignment="Center" />
                                                        <DatePicker Width="125" Margin="6,0,4,0"
                                                                    SelectedDate="{Binding StartDate}" />
                                                        <TextBox Width="75" Margin="0,0,10,0"
                                                                 Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="任意の時刻（HH:mm または HH:mm:ss）" />
                                                        <TextBlock Text="終了日" VerticalAlignment="Center" />
                                                        <DatePicker Width="125" Margin="6,0,4,0"
                                                                    SelectedDate="{Binding EndDate}" />
                                                        <TextBox Width="75" Margin="0,0,10,0"
                                                                 Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="任意の時刻（HH:mm または HH:mm:ss）" />
                                                        <TextBlock Text="タイムゾーン" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTimeZoneDate}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Width="95" Margin="6,0,0,0"
                                                                 Text="{Binding TimeZoneSpecifier, UpdateSourceTrigger=PropertyChanged}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTimeZoneDate}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </WrapPanel>

                                                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,7,0,0">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Margin="0,0,14,3" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <CheckBox Content="Unknownを含める"
                                                              IsChecked="{Binding IncludeUnknown}"
                                                              IsEnabled="{Binding CanIncludeUnknown}"
                                                              Margin="0,7,0,0" />
                                                    <TextBlock Text="{Binding ValidationMessage}"
                                                               Foreground="Firebrick"
                                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FilterEditStatus}"
                                       Visibility="{Binding FilterEditStatusVisibility}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="条件を追加" Click="AddFilterCondition_Click"
                                        AutomationProperties.AutomationId="AddFilterCondition"
                                        IsEnabled="{Binding CanEditFilters}" Margin="0,0,8,0" />
                                <Button Content="クリア" Click="ClearFilter_Click"
                                        AutomationProperties.AutomationId="ClearFilter"
                                        IsEnabled="{Binding CanEditFilters}" Margin="0,0,8,0" />
                                <Button Content="適用" Click="ApplyFilter_Click"
                                        AutomationProperties.AutomationId="ApplyFilter"
                                        IsEnabled="{Binding CanApplyFilter}" MinWidth="88" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.RowSpan="7" Grid.Column="1"
                      Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Columns" />

        <Border Grid.Row="1" Grid.RowSpan="7" Grid.Column="2" Margin="14,0,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" CornerRadius="4" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="トークン詳細" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Grid.Column="1" Content="画像プレビューを表示"
                              IsChecked="{Binding ShowImagePreview, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="選択した画像のプレビューを表示" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="180" Margin="0,0,0,10"
                        Visibility="{Binding ImagePreviewVisibility}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderThickness="1" CornerRadius="3">
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding ImagePreviewSource, Mode=OneWay}"
                               Margin="8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="選択した画像のプレビュー" />
                        <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                Visibility="{Binding ImagePreviewPlaceholderVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="18">
                                <TextBlock Text="{Binding ImagePreviewStatus}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="DimGray" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectedSourcePath}" Margin="0,4,0,0"
                               TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ExifReadStatus}" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="DimGray" />
                    <TextBlock Text="書式欄を変更すると、その書式で値を再評価します。"
                               Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <GroupBox Header="ファイルシステム系" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding FileSystemTokenDetails}"
                                          ItemTemplate="{StaticResource TokenDetailTemplate}" Margin="10,4" />
                        </GroupBox>
                        <GroupBox Header="Exif系">
                            <ItemsControl ItemsSource="{Binding ExifTokenDetails}"
                                          ItemTemplate="{StaticResource TokenDetailTemplate}" Margin="10,4" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="8" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                         Visibility="{Binding ProgressVisibility}" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="18,0,0,0"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
