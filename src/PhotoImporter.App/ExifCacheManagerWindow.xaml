<Window x:Class="PhotoImporter.App.ExifCacheManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exif キャッシュの管理"
        Width="1120" Height="680" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Exif キャッシュの管理" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"
                       Text="カードごとのキャッシュ容量を確認し、名前の変更や古いエントリの整理ができます。キャッシュを削除しても写真ファイルは削除されません。" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="10,7"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="現在の保存先" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="14,0,0,0" Padding="4,2"
                         Text="{Binding CurrentRoot, Mode=OneWay}" IsReadOnly="True"
                         AutomationProperties.AutomationId="CurrentExifCacheRoot"
                         AutomationProperties.Name="現在の Exif キャッシュ保存先" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" IsEnabled="{Binding IsContentEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="保存先">
                <ListBox x:Name="RootList" ItemsSource="{Binding Roots}"
                         SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                         AutomationProperties.Name="Exif キャッシュの保存先一覧">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Path}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock Text="{Binding Summary}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Warning}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="Firebrick" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="CardGrid" ItemsSource="{Binding SelectedRoot.Cards}"
                          SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          AutomationProperties.Name="キャッシュのあるカード一覧">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状態" Binding="{Binding StateText}" Width="110" />
                        <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="ボリューム" Binding="{Binding VolumeText}" Width="150" />
                        <DataGridTextColumn Header="種類" Binding="{Binding DriveText}" Width="95" />
                        <DataGridTextColumn Header="記録媒体容量" Binding="{Binding TotalSizeText}" Width="105" />
                        <DataGridTextColumn Header="キャッシュ" Binding="{Binding CacheSizeText}" Width="95" />
                        <DataGridTextColumn Header="件数" Binding="{Binding EntryCountText}" Width="70" />
                        <DataGridTextColumn Header="最終利用日 (UTC)" Binding="{Binding LastUsedText}" Width="120" />
                        <DataGridTextColumn Header="状態詳細" Binding="{Binding Warning}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="0" Text="この保存先には管理対象のキャッシュがありません。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="DimGray" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoot.HasCards}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="名前を変更..." Padding="12,4" Margin="0,0,8,0"
                            IsEnabled="{Binding CanManageSelectedCard}"
                            Click="RenameCard_Click"
                            AutomationProperties.AutomationId="RenameExifCacheCard" />
                    <Button Content="古いエントリを整理..." Padding="12,4" Margin="0,0,8,0"
                            IsEnabled="{Binding CanManageSelectedCard}"
                            Click="RemoveOldEntries_Click"
                            AutomationProperties.AutomationId="PruneExifCacheCard" />
                    <Button Content="カードのキャッシュを削除..." Padding="12,4"
                            IsEnabled="{Binding CanManageSelectedCard}"
                            Click="DeleteCard_Click"
                            AutomationProperties.AutomationId="DeleteExifCacheCard" />
                </WrapPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{Binding StatusBrush}"
                       AutomationProperties.AutomationId="ExifCacheManagerStatus" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="更新" Padding="14,4" Margin="8,0,0,0"
                        IsEnabled="{Binding IsContentEnabled}" Click="Refresh_Click"
                        AutomationProperties.AutomationId="RefreshExifCacheManager" />
                <Button Content="閉じる" Padding="14,4" Margin="8,0,0,0"
                        IsCancel="True" Click="Close_Click"
                        AutomationProperties.AutomationId="CloseExifCacheManager" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
